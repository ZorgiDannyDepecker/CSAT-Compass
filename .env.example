# CSAT-Compass — omgevingsvariabelen template
# Kopieer dit bestand naar .env en vul de waarden in.
# NOOIT het .env bestand committen naar Git.

# --- Database configuratie ---
CSAT_DB_SERVER=ZRG0014WI
CSAT_DB_NAME=Lerni_DB
CSAT_DB_SCHEMA=dbo
CSAT_DB_VIEW=V_CSAT_1
CSAT_DB_USER=csat_user
CSAT_DB_PASSWORD=JOUW_WACHTWOORD_HIER
CSAT_DB_DRIVER=ODBC Driver 18 for SQL Server

# --- Paden ---
CSAT_CSV_FALLBACK_PATH=data/fallback/
CSAT_OUTPUT_PATH=output/
CSAT_LOG_PATH=logs/

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
CSAT_LOG_LEVEL=INFO

# --- Dashboard weergave-modus ---
# demo = Deploy-knop en drie-puntjes zichtbaar (lokaal / beta)
# prod = Deploy-knop en drie-puntjes verborgen (productie)
CSAT_DASHBOARD_MODE=demo

# --- Fase 7B: Maandelijkse mail-distributie (Deel C) ---
# Ontvangers gescheiden door puntkomma, geen spaties.
CSAT_MAIL_TO=tom.delaere@zorgi.be;thomas.wyckstandt@zorgi.be;erwin.casier@zorgi.be
CSAT_MAIL_CC=danny.depecker@zorgi.be
CSAT_MAIL_SUBJECT_PREFIX=CSAT-Compass
